# voice — local secrets (copy to secrets.local, never commit secrets.local)
#
# Loaded by client at launch (Keychain on iOS/macOS, env on backend).
# See specs/backend-protocol.md for auth model.

# ---- Client → Backend ----

# Backend base URL. WireGuard internal address recommended (no public exposure).
# Example: http://10.0.0.5:8089  or  https://voice.example.com
BACKEND_URL=

# Bearer token for Authorization header. Generated server-side, distributed
# manually to each trusted client. Rotate by editing backend env + reissuing.
BACKEND_TOKEN=

# Which BackendAdapter implementation to load at runtime.
# Allowed: dispatcher | raw_http | (future: slack, own_server)
ADAPTER_TYPE=dispatcher

# Client identifier sent with each request (free-form, used for log routing).
# Example: iphone-15-sergey, macbook-m1-sergey
CLIENT_ID=

# ---- Backend-only (lives on VDS, NOT shipped to clients) ----

# Listening port for Hummingbird service. Match systemd unit.
VOICE_BACKEND_PORT=8089

# JSONL log path (observability sink).
VOICE_LOG_PATH=/var/log/voice.jsonl

# Adapter-specific config below — only the one matching ADAPTER_TYPE is read.

# DispatcherAdapter (forwards to Happy inject API). Private to author's
# infrastructure. Other adapters expose their own variables.
HAPPY_SERVER_URL=https://api.cluster-fluster.com
HAPPY_ACCESS_KEY_PATH=~/.happy/access.key
HAPPY_TARGET_CWD=/root/projects/assistant
