# voice — local secrets (copy to secrets.local, never commit secrets.local)
#
# Loaded by client at launch (Keychain on iOS/macOS, env on backend).
# See specs/backend-protocol.md for auth model.

# ---- Client → Backend ----

# Backend base URL. WireGuard internal address recommended (no public exposure).
# Example: http://10.0.0.5:8089  or  https://voice.example.com
BACKEND_URL=

# Bearer token for Authorization header. Generated server-side, distributed
# manually to each trusted client. Rotate by editing backend env + reissuing.
BACKEND_TOKEN=

# Which BackendAdapter implementation to load at runtime.
# Allowed: dispatcher | raw_http | (future: slack, own_server)
ADAPTER_TYPE=dispatcher

# Client identifier sent with each request (free-form, used for log routing).
# Example: iphone-15-sergey, macbook-m1-sergey
CLIENT_ID=

# ---- Backend-only (lives on VDS, NOT shipped to clients) ----

# Listening port for Hummingbird service. Match systemd unit.
VOICE_BACKEND_PORT=8089

# JSONL log path (observability sink).
VOICE_LOG_PATH=/var/log/voice.jsonl

# Adapter-specific config below — only the one matching ADAPTER_TYPE is read.

# DispatcherAdapter (forwards to Happy inject API). Private to author's
# infrastructure. Other adapters expose their own variables.
HAPPY_SERVER_URL=https://api.cluster-fluster.com
HAPPY_ACCESS_KEY_PATH=~/.happy/access.key
HAPPY_TARGET_CWD=/root/projects/assistant

# Навык Алисы (docs/alice-skill-input.md). Без ALICE_PATH_SECRET маршрут
# /v1/alice не поднимается вовсе.
# Секрет живёт в пути: Диалоги заголовков не шлют, Bearer'ом не закрыть.
ALICE_PATH_SECRET=32-hex-символа
# Сверка навыка по телу запроса. Пусто — не проверяем.
ALICE_SKILL_ID=
# Ящик ответа: агент пишет текст файлом, человек говорит «дай ответ»,
# навык озвучивает и опустошает. Пусто — путь по умолчанию.
ALICE_ANSWER_FILE=/var/lib/voice-bot/alice-answer.txt
# ТОЛЬКО для обкатки: адресовать инжект в конкретную happy-сессию, когда в
# каталоге их несколько живых. В проде оставлять пустым — sid умирает вместе
# с инкарнацией сессии, и следить за этим некому.
ALICE_TARGET_SID=

# Навык умного дома — пуш на колонку (docs/plans/2026-10-04-alice-smart-home-push.md).
# Нет хотя бы одной из четырёх — навык не поднимается вовсе: полумёртвая
# конфигурация хуже отсутствующей.
# Логин и пароль вводятся один раз, при привязке навыка в «Доме с Алисой».
SMART_HOME_LOGIN=sergey
SMART_HOME_PASSWORD=
# Эти два значения придумываете вы и вписываете в консоль Диалогов.
SMART_HOME_CLIENT_ID=
SMART_HOME_CLIENT_SECRET=
# ID навыка умного дома из консоли — им подписывается callback.
SMART_HOME_SKILL_ID=
# Идентификатор и имя виртуальной лампочки. Имя видно в приложении.
SMART_HOME_DEVICE_ID=voice-notify-1
SMART_HOME_DEVICE_NAME=Уведомление
