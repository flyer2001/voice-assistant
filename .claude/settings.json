{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/root/projects/agentops/bin/wrap-with-hb.sh"
          },
          {
            "type": "command",
            "command": "/root/projects/agentops/bin/loop-detector.sh"
          },
          {
            "type": "command",
            "command": "/root/projects/voice/backend/voice-service/deploy/live-transcribe/voice-live-gate.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/root/projects/agentops/bin/agentops-dispatcher-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/voice-mac-auto-reply.sh",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
