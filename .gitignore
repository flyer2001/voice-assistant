# Swift / SPM
.build/
.swiftpm/
Packages/
Package.resolved
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
DerivedData/
*.dSYM.zip
*.dSYM

# Xcode user-specific
xcuserdata/
*.moved-aside

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Secrets / local config — NEVER commit
secrets.local
secrets.local.*
.env
.env.*
!.env.example
*.pem
*.key
!secrets.example

# WhisperKit downloaded models (large, fetched at runtime).
# Anchored so they don't collide with Sources/VoiceAssistant/Models/ (Swift types).
/Models/
Sources/VoiceAssistant/Resources/whisperkit/Models/
*.mlmodelc
*.mlpackage

# IDE
.vscode/
.idea/

# OS
Thumbs.db
*.log

# Build artifacts
*.ipa
*.app
*.dmg

# Tests output
/tmp/test.log
.coverage/

# Benchmark assets — raw audio, derived files, large outputs
assets/
bench/.venv/
bench/results/*.csv
bench/results/mac/
bench/results/win/
bench/raw/
bench/derived/

# Generated Xcode project (regenerated from iOS/project.yml via xcodegen)
iOS/VoiceAssistantApp.xcodeproj/

# Bundled audio resources — копируются в SPM library Sources/ через iOS/setup-resources.sh.
# Pattern ignores contents but NOT the directory itself, so .gitkeep markers can be
# committed (Bundle.module is only generated when SPM target's resources path exists).
Sources/VoiceAssistant/Resources/audio/*
iOS/VoiceAssistant/Resources/audio/*
!Sources/VoiceAssistant/Resources/audio/.gitkeep
!iOS/VoiceAssistant/Resources/audio/.gitkeep
bench/scripts/__pycache__/

# TTS bench venv
bench/scripts/tts/.venv/
bench/scripts/tts/__pycache__/
bench/results/tts/
Sources/VoiceAssistant/Resources/whisperkit/openai_whisper-*/
