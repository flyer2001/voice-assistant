# /etc/voice-backend.env — environment file for voice-backend.service
# Copy to /etc/voice-backend.env with chmod 600 root:root.

# Required: static Bearer token clients must present in Authorization header.
# Generate: `openssl rand -hex 32`
VOICE_BACKEND_TOKEN=<set-me>

# /v1/voice/intent — Happy assistant inject ───────────────────────────
# HAPPY_MODE = echo | live | (unset)
#   echo  — reply "[echo reply] <text>", no Happy state needed (smoke / dev).
#   live  — read ~/.happy, encrypt envelope, POST, tail JSONL for reply.
#           Requires VOICE_TARGET_CWD.
#   unset — live if VOICE_TARGET_CWD is set, otherwise echo (backwards compat).
HAPPY_MODE=live
VOICE_TARGET_CWD=/root/projects/cashflow

# /v1/voice/audio — server-side STT ────────────────────────────────────
# STT_MODE = mock | live | (unset)
#   mock  — echo `[mock] N bytes from <client_id>`. Smoke.
#   live  — proxy to Whisper FastAPI at WHISPER_URL (ubuntu-home default).
#   unset — endpoint returns 503 stt_unavailable.
# STT_MODE=live
# WHISPER_URL=http://192.168.88.13:8000

# Optional overrides (defaults in unit file):
# VOICE_HOST=127.0.0.1
# VOICE_PORT=8089
# VOICE_LOG_PATH=/var/log/voice.jsonl
# HAPPY_SERVER_URL=https://api.cluster-fluster.com
# HAPPY_HOME_DIR=/root/.happy
