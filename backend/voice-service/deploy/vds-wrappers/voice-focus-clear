#!/usr/bin/env bash
# voice-focus-clear <peer_id>
# Clears /var/lib/voice-bot/focus.json → next voice routes to dispatcher.
# TTS-acks Sergey «вернулся в диспетчер».
#
# Install on VDS:
#   sudo install -m 755 backend/voice-service/deploy/voice-focus-clear /usr/local/bin/
set -euo pipefail

# Пути через env — чтобы тест не переписывал боевой focus.json и не слал
# настоящее голосовое. Дефолты = прод.
REPLY_TTS="${VOICE_REPLY_TTS:-/usr/local/bin/voice-reply-tts}"
FOCUS_FILE="${VOICE_FOCUS_PATH:-/var/lib/voice-bot/focus.json}"

PEER="${1:?peer_id required}"

# Пишем через временный файл: бот читает focus.json на каждое сообщение,
# и если войс придёт ровно между открытием и записью, он увидит пустой
# файл вместо {"cwd":null}. rename атомарен.
TMP="$(mktemp "${FOCUS_FILE}.XXXXXX")"
printf '{"cwd":null}\n' > "$TMP"
mv -f "$TMP" "$FOCUS_FILE"

exec "$REPLY_TTS" "$PEER" "вернулся в диспетчер"
